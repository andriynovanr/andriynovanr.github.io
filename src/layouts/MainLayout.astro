    <!-- Lampu Gantung dengan Efek Sinar Cahaya -->
    <HangingLamp />
    
    <slot />
  </body>
</html>

<script>
  // @ts-ignore - AlpineJS loaded via CDN
  import Alpine from 'alpinejs';

  Alpine.data('portfolioApp', () => ({
    showEnvelopeModal: false,
    showSkillsModal: false,
    showContactModal: false,
    showProjectModal: false,
    currentProjectIndex: 0,
    isSoundOn: true,
    sanityLevel: 85,
    activeCareerTab: 2,

    init() {
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.closeAllModals();
        }
      });
      
      // Listen for custom close modal event from form submission
      window.addEventListener('close-modal', () => {
        this.closeAllModals();
      });
    },

    openModal(name: string) {
      this.closeAllModals();
      if (name === 'envelope') this.showEnvelopeModal = true;
      if (name === 'skills') this.showSkillsModal = true;
      if (name === 'contact') this.showContactModal = true;
      if (name === 'project') this.showProjectModal = true;
    },

    closeAllModals() {
      this.showEnvelopeModal = false;
      this.showSkillsModal = false;
      this.showContactModal = false;
      this.showProjectModal = false;
    },

    toggleSound() {
      this.isSoundOn = !this.isSoundOn;
    },

    setCareerTab(tab: number) {
      this.activeCareerTab = tab;
    }
  }));

  Alpine.start();
  
  // Adjust background wrapper height to match page content (with extra padding for zoom out)
  function adjustBackgroundHeight() {
    const body = document.body;
    const pageContent = document.querySelector('.page-content');
    const bgWrapper = document.querySelector('.courtroom-backgrounds-wrapper');
    
    if (pageContent && bgWrapper) {
      const contentHeight = pageContent.offsetHeight;
      const viewportHeight = window.innerHeight;
      
      // Calculate proper height: content + padding, with 2x multiplier for zoom out coverage
      const calculatedHeight = Math.max(contentHeight + 200, viewportHeight);
      const finalHeight = calculatedHeight * 2; // 2x untuk cover zoom out 50%, 33%, 25%
      
      bgWrapper.style.height = finalHeight + 'px';
      
      // Set body height to match content + padding only (no extra scroll)
      body.style.height = (contentHeight + 200) + 'px';
    }
  }
  
  // Run on load and resize
  window.addEventListener('load', adjustBackgroundHeight);
  window.addEventListener('resize', adjustBackgroundHeight);
  
  // Run initially with a small delay to ensure content is rendered
  setTimeout(adjustBackgroundHeight, 100);
  
  // Also run after a longer delay to catch any late-loading content
  setTimeout(adjustBackgroundHeight, 500);
  setTimeout(adjustBackgroundHeight, 1000);
</script>
