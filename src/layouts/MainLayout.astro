---
import '../styles/global.css';
import HangingLamp from '../components/decoration/HangingLamp.astro';

interface Props {
  title?: string;
}

const { title = 'Andriy Novan Rahman — Court Dossier' } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <met name="description" content="Portfolio Andriy Novan Rahman — Software QA Engineer, Full-Stack Developer, Pentester" />
    <title>{title}</title>
    <style>
      /* ============================================
         SISTEM LAYOUT VERTIKAL COURTROOM - SCROLLABLE
         Total Height: 1400px (container absolut)
         ============================================ */
      
      /* Wrapper background container */
      .courtroom-backgrounds-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        min-width: 100vw;
        min-height: 100vh;
        height: 100%;
        z-index: -10;
        pointer-events: none;
      }
      
      /* ZONA 1: Dinding Kayu Atas - Judge Bench Backdrop (0px - 600px, 45.1%) */
      .courtroom-upper-wall-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        min-width: 100%;
        height: 600px;
        display: flex;
        align-items: stretch;
        justify-content: flex-start;
        overflow: visible;
      }

      /* Bilah papan kayu vertikal lebar dengan efek silinder */
      .upper-wall-plank {
        min-width: 145px;
        width: 145px;
        height: 100%;
        flex-shrink: 0;
        position: relative;
        background: linear-gradient(
          to right,
          #3A1E0B 0%,
          #42210D 8%,
          #4F270F 18%,
          #5A2E12 28%,
          #613415 40%,
          #683817 50%,
          #6D3A18 60%,
          #613415 72%,
          #5A2E12 82%,
          #42210D 92%,
          #361B09 100%
        );
      }

      /* Garis celah sambungan antar papan (Seam Groove Line) */
      .upper-wall-plank::after {
        content: '';
        position: absolute;
        right: -1px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(
          180deg,
          #200E04 0%,
          #1A0C03 50%,
          #200E04 100%
        );
      }

      .upper-wall-plank:last-child::after {
        display: none;
      }

      /* Transisi vertikal gelap ke bawah (Y: 460px - 510px) */
      .upper-wall-vertical-fade {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
          180deg,
          rgba(40, 18, 5, 0) 0%,
          rgba(40, 18, 5, 0) 90%,
          rgba(40, 18, 5, 0.5) 95%,
          rgba(29, 12, 3, 0.8) 100%
        );
        z-index: 2;
      }

      /* ZONA 2: Panel Kayu Vertikal Tengah - Middle Wainscoting (600px - 750px, 11.3%) */
      .wood-panel-middle-bg {
        position: absolute;
        top: 600px;
        left: 0;
        width: 100%;
        min-width: 100%;
        height: 150px;
        background: linear-gradient(
          180deg,
          #6b3314 0%,
          #743714 25%,
          #7b3c17 50%,
          #803f19 75%,
          #7b3c17 100%
        );
        display: flex;
        align-items: stretch;
        justify-content: flex-start;
        border-bottom: 4px solid #1A0F07;
        overflow: visible;
      }

      .wood-plank-middle {
        width: 80px;
        height: 100%;
        border-right: 3.5px solid #4E240C;
        flex-shrink: 0;
        position: relative;
      }

      .wood-plank-middle::after {
        content: '';
        position: absolute;
        right: -4px;
        top: 0;
        bottom: 0;
        width: 0.5px;
        background: rgba(160, 90, 40, 0.2);
      }

      /* ZONA 3: Balok Krem Manila - Partition Railing (750px - 802px, 3.9%) */
      .gallery-partition-bg {
        position: absolute;
        top: 750px;
        left: 0;
        right: 0;
        height: 52px;
        background: linear-gradient(
          180deg,
          #DDD4BE 0%,
          #D8CEB7 50%,
          #D0C5AD 100%
        );
        border-top: 4px solid #1A0F07;
        border-bottom: 4px solid #140B04;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .partition-posts-bg {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 100%;
        height: 100%;
        padding: 0 30px;
      }

      .post-item-bg {
        width: 13px;
        height: 34px;
        background: #BCAC91;
        border: 2px solid #1A0F07;
        border-radius: 2px;
        flex-shrink: 0;
      }

      /* Semua jepitan (corner dan tengah) dalam satu flex container untuk jarak sama rata */
      .post-item-corner-left,
      .post-item-corner-right {
        width: 13px;
        height: 34px;
        background: #BCAC91;
        border: 2px solid #1A0F07;
        border-radius: 2px;
        flex-shrink: 0;
      }

      /* Responsive untuk mobile */
      @media (max-width: 768px) {
        .partition-posts-bg {
          padding: 0 20px;
        }
      }

      @media (max-width: 480px) {
        .partition-posts-bg {
          padding: 0 15px;
        }
        
        .post-item-bg,
        .post-item-corner-left,
        .post-item-corner-right {
          width: 11px;
          height: 30px;
        }
      }

      /* ZONA 4: Lantai Biru Toska - Courtroom Floor (802px - extends to page bottom) */
      .courtroom-floor-bg {
        position: absolute;
        top: 802px;
        left: 0;
        right: 0;
        width: 100%;
        min-width: 100%;
        height: calc(100% - 802px);
        min-height: calc(100vh - 802px);
        background: linear-gradient(
          180deg,
          #1E535F 0%,
          #2A6D7C 6px,
          #2A6D7C calc(100% - 4px),
          #245C69 100%
        );
        border-bottom: 4px solid #1C0E05;
      }
    </style>
  </head>
  <body x-data="portfolioApp">
