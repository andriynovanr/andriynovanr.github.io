      <!-- ZONA 3: Balok Krem (630-682px) -->
      <div class="gallery-partition-bg">
        <div class="partition-posts-bg">
          <!-- Total 8 jepitan: corner kiri + 6 tengah + corner kanan -->
          <div class="post-item-corner-left"></div>
