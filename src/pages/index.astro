---
import MainLayout from '../layouts/MainLayout.astro';
import TopBar from '../components/navigation/TopBar.astro';
import BottomNav from '../components/navigation/BottomNav.astro';
import HeroCard from '../components/hero/HeroCard.astro';
import EnvelopeSection from '../components/hero/EnvelopeSection.astro';
import TestimonyPlaque from '../components/hero/TestimonyPlaque.astro';
import CareerPlaque from '../components/sections/CareerPlaque.astro';
import CareerExhibit from '../components/sections/CareerExhibit.astro';
import ModalEnvelope from '../components/modals/ModalEnvelope.astro';
import ModalSkills from '../components/modals/ModalSkills.astro';
import ModalContact from '../components/modals/ModalContact.astro';
import WallClock from '../components/hud/WallClock.astro';
---

<MainLayout title="Andriy Novan Rahman — Court Dossier">
  <!-- Fixed navigation bars -->
  <TopBar />
  <BottomNav />

  <!-- Main scrollable content area -->
  <main class="page-content">
    <!-- Hero section with profile card -->
    <HeroCard />

    <!-- Container untuk Photo Card dan Testimony Plaque -->
    <div class="hero-witness-container">
      <!-- Photo ID Card -->
      <EnvelopeSection />
      
      <!-- Testimony Plaque di samping kanan -->
      <TestimonyPlaque />
    </div>

    <!-- Career & Experience Section -->
    <div class="career-section">
      <CareerPlaque />
      <CareerExhibit />
    </div>
  </main>

  <!-- Wall Clock HUD -->
  <WallClock />

  <!-- Modals (hidden until triggered) -->
  <ModalEnvelope />
  <ModalSkills />
  <ModalContact />
</MainLayout>
