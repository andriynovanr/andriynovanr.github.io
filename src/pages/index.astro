---
import MainLayout from '../layouts/MainLayout.astro';
import TopBar from '../components/navigation/TopBar.astro';
import BottomNav from '../components/navigation/BottomNav.astro';
import HeroCard from '../components/hero/HeroCard.astro';
import EnvelopeSection from '../components/hero/EnvelopeSection.astro';
import CareerSection from '../components/sections/CareerSection.astro';
import ModalEnvelope from '../components/modals/ModalEnvelope.astro';
import ModalSkills from '../components/modals/ModalSkills.astro';
import ModalContact from '../components/modals/ModalContact.astro';
---

<MainLayout title="Andriy Novan Rahman — Court Dossier">
  <!-- Fixed navigation bars -->
  <TopBar />
  <BottomNav />

  <!-- Main scrollable content area -->
  <main class="page-content">
    <!-- Hero section with profile card -->
    <HeroCard />

    <!-- Envelope CTA section -->
    <EnvelopeSection />

    <!-- Career & experience tabbed section -->
    <CareerSection />
  </main>

  <!-- Modals (hidden until triggered) -->
  <ModalEnvelope />
  <ModalSkills />
  <ModalContact />
</MainLayout>
