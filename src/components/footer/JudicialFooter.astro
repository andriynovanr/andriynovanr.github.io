---
// JudicialFooter - Judicial Editorial Footer dengan Archive & Dispatch Cards
---

<footer class="judicial-footer">
  <div class="footer-container">
    <!-- Grid 2 Kolom -->
    <div class="footer-grid">
      
      <!-- KOLOM KIRI: Identitas Resmi & Pernyataan -->
      <div class="footer-left">
        <!-- A. Lencana Pembuka -->
        <div class="archive-badge">
          <svg class="scales-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
            <path d="M12 3v18M8 21h8M12 5l-5 7h10l-5-7zM4 12l3-4h3l-3 4H4zM20 12l-3-4h-3l3 4h3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>OFFICIAL BENCH ARCHIVE · CASE SEAL 2026</span>
        </div>

        <!-- B. Nama Utama -->
        <h2 class="footer-name">ANDRIY NOVAN RAHMAN</h2>

        <!-- C. Gelar & Spesialisasi -->
        <p class="footer-title">Software QA Engineer & Offensive Security Researcher</p>

        <!-- D. Lencana Dokumen Perkara -->
        <div class="probate-badge">
          <div class="wax-seal"></div>
          <span class="probate-left">PROBATE CODE BENCH</span>
          <span class="probate-right">TELKOM UNIVERSITY SURABAYA</span>
        </div>

        <!-- E. Nomor Arsip -->
        <p class="docket-number">DOCKET #ANR-2026</p>

        <!-- F. Kutipan Motto -->
        <blockquote class="quality-motto">
          "Ensuring zero critical leaks through rigorous test automation suites, meticulous regression defense, and adversarial web security audits."
        </blockquote>
      </div>

      <!-- KOLOM KANAN: Status & Kartu Dispatch -->
      <div class="footer-right">
        <!-- A. Header Status -->
        <div class="status-header">
          <div class="status-left">
            <div class="status-indicator"></div>
            <span class="status-label">DISPATCH STATUS:</span>
          </div>
          <div class="status-badge">AVAILABLE FOR ROLES</div>
        </div>

        <!-- B. Trio Kartu Komunikasi -->
        <div class="dispatch-cards">
          <!-- GitHub Card -->
          <a href="https://github.com/andriynovanr" target="_blank" rel="noopener noreferrer" class="dispatch-card">
            <div class="card-content">
              <div class="card-icon github-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              </div>
              <div class="card-text">
                <p class="card-label">GITHUB REPOSITORY</p>
                <p class="card-url">github.com/andriynovanr</p>
              </div>
              <div class="card-arrow">↗</div>
            </div>
          </a>

          <!-- LinkedIn Card -->
          <a href="https://www.linkedin.com/in/andriy-novan-rahman/" target="_blank" rel="noopener noreferrer" class="dispatch-card">
            <div class="card-content">
              <div class="card-icon linkedin-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <div class="card-text">
                <p class="card-label">LINKEDIN COUNSEL</p>
                <p class="card-url">linkedin.com/in/andriynovanr</p>
              </div>
              <div class="card-arrow">↗</div>
            </div>
          </a>

          <!-- Email Card -->
          <a href="mailto:andriynovanr@gmail.com" class="dispatch-card">
            <div class="card-content">
              <div class="card-icon email-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="2" y="4" width="20" height="16" rx="2" stroke-width="2"/>
                  <path d="M2 7l10 7 10-7" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="card-text">
                <p class="card-label">DIRECT WIRE / DISPATCH</p>
                <p class="card-url">andriynovanr@gmail.com</p>
              </div>
              <div class="card-arrow">↗</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bilah Bawah Sub-Docket -->
    <div class="sub-docket">
      <div class="copyright">
        <span class="courthouse-icon">🏛</span>
        <span>© 2026 ANDRIY NOVAN RAHMAN · ALL RIGHTS ADMISSIBLE · TELKOM UNIVERSITY SURABAYA ALUMNUS</span>
      </div>
      <button class="return-bench" @click="window.scrollTo({ top: 0, behavior: 'smooth' })">
        RETURN TO BENCH ↑
      </button>
    </div>
  </div>
</footer>

<style>
  /* ============================================
     JUDICIAL FOOTER - FOUNDATION
     ============================================ */
  .judicial-footer {
    width: 100%;
    background: linear-gradient(180deg, #1d1007 0%, #150a04 100%);
    border-top: 3px solid #120803;
    box-shadow: inset 0 1.5px 0 #8e6527;
    padding: 64px 24px 48px;
    position: relative;
    transition: background 0.5s ease;
  }

  /* Dark mode */
  body.dark-mode .judicial-footer {
    background: linear-gradient(180deg, #0d0603 0%, #080402 100%);
  }

  .footer-container {
    max-width: 1152px;
    margin: 0 auto;
  }

  /* ============================================
     GRID 2 KOLOM
     ============================================ */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin-bottom: 64px;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ============================================
     KOLOM KIRI - IDENTITAS
     ============================================ */
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* A. Lencana Pembuka */
  .archive-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(40, 20, 10, 0.7);
    border: 1.5px solid #4a2712;
    border-radius: 6px;
    width: fit-content;
  }

  .scales-icon {
    color: #e5b342;
  }

  .archive-badge span {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #e5b342;
    text-transform: uppercase;
  }

  /* B. Nama Utama */
  .footer-name {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 36px;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #f8f5eb;
    text-shadow: 2px 2px 0px #0c0502, 3px 3px 0px #000000;
    margin: 8px 0;
    line-height: 1.2;
  }

  /* C. Gelar & Spesialisasi */
  .footer-title {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 16px;
    font-weight: 700;
    color: #e8cb89;
    margin-bottom: 8px;
  }

  /* D. Lencana Dokumen */
  .probate-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    background: rgba(30, 15, 8, 0.85);
    border: 1.5px solid #482813;
    border-radius: 999px;
    width: fit-content;
  }

  .wax-seal {
    width: 10px;
    height: 10px;
    background: #eab308;
    border: 1px solid #1a0a03;
    border-radius: 50%;
  }

  .probate-left {
    font-family: 'Special Elite', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #ded6c3;
  }

  .probate-right {
    font-family: 'Special Elite', monospace;
    font-size: 9.5px;
    font-weight: 600;
    color: #9b876a;
  }

  /* E. Nomor Arsip */
  .docket-number {
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #cca046;
    margin-top: 8px;
  }

  /* F. Kutipan Motto */
  .quality-motto {
    font-family: 'Special Elite', monospace;
    font-size: 14px;
    font-style: italic;
    line-height: 1.6;
    color: #a89984;
    margin-top: 16px;
    padding-left: 16px;
    border-left: 2px solid #3d2110;
  }

  /* ============================================
     KOLOM KANAN - STATUS & DISPATCH
     ============================================ */
  .footer-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* A. Header Status */
  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-indicator {
    width: 12px;
    height: 12px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
  }

  .status-label {
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    font-weight: 700;
    color: #c2b090;
  }

  .status-badge {
    padding: 4px 10px;
    background: #134e3a;
    border: 1.5px solid #10b981;
    border-radius: 4px;
    font-family: 'Special Elite', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #6ee7b7;
  }

  /* B. Kartu Dispatch */
  .dispatch-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dispatch-card {
    padding: 14px;
    background: #24140a;
    border: 2px solid #3d2110;
    border-radius: 12px;
    box-shadow: 0 4px 0px 0px #0e0602;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
  }

  .dispatch-card:hover {
    transform: translateY(-2px);
    background: #301b0e;
    border-color: #d4a359;
    box-shadow: 0 6px 0px 0px #0e0602;
  }

  .dispatch-card:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0px 0px #0e0602;
  }

  .card-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .github-icon {
    background: #e8b655;
    color: #1a0e06;
  }

  .linkedin-icon {
    background: #0077b5;
    color: white;
  }

  .email-icon {
    background: #d4a359;
    color: #1a0e06;
  }

  .card-text {
    flex: 1;
  }

  .card-label {
    font-family: 'Special Elite', monospace;
    font-size: 12px;
    font-weight: 700;
    color: #f5eedc;
    margin-bottom: 2px;
  }

  .card-url {
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    color: #d9b873;
  }

  .card-arrow {
    font-size: 18px;
    color: #d4a359;
    transition: transform 0.2s ease;
  }

  .dispatch-card:hover .card-arrow {
    transform: translate(2px, -2px);
  }

  /* ============================================
     SUB-DOCKET BAR
     ============================================ */
  .sub-docket {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    margin-top: 40px;
    border-top: 1px solid #2e190c;
  }

  .copyright {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Special Elite', monospace;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: #8c7457;
  }

  .courthouse-icon {
    font-size: 14px;
  }

  .return-bench {
    padding: 6px 14px;
    background: #241308;
    border: 1.5px solid #3d200e;
    border-radius: 6px;
    box-shadow: 0 2px 0px #0c0502;
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    font-weight: 700;
    color: #e5b342;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .return-bench:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 0px #0c0502;
    border-color: #d4a359;
  }

  .return-bench:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0px #0c0502;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    .judicial-footer {
      padding: 48px 16px 32px;
    }

    .footer-name {
      font-size: 28px;
    }

    .footer-title {
      font-size: 14px;
    }

    .sub-docket {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

    .copyright {
      font-size: 9px;
    }
  }

  @media (max-width: 480px) {
    .footer-name {
      font-size: 24px;
    }

    .archive-badge span {
      font-size: 9px;
    }
  }
</style>
