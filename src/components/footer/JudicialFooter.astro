---
// JudicialFooter - Judicial Editorial Footer dengan Archive & Dispatch Cards
---

<footer class="judicial-footer">
  <div class="footer-container">
    <!-- Grid 2 Kolom -->
    <div class="footer-grid">
      
      <!-- KOLOM KIRI: Nama & Motto -->
      <div class="footer-left">
        <!-- Nama Utama -->
        <h2 class="footer-name">ANDRIY NOVAN RAHMAN</h2>

        <!-- Kutipan Motto -->
        <blockquote class="quality-motto">
          "Ensuring zero critical leaks through rigorous test automation suites, meticulous regression defense, and adversarial web security audits."
        </blockquote>
      </div>

      <!-- KOLOM KANAN: Link Kontak -->
      <div class="footer-right">
        <!-- Link Sederhana -->
        <div class="contact-links">
          <!-- GitHub Link -->
          <a href="https://github.com/andriynovanr" target="_blank" rel="noopener noreferrer" class="contact-link">
            github.com/andriynovanr
          </a>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/andriy-novan-rahman/" target="_blank" rel="noopener noreferrer" class="contact-link">
            linkedin.com/in/andriynovanr
          </a>

          <!-- Email Link -->
          <a href="mailto:andriynovanr@gmail.com" class="contact-link">
            andriynovanr@gmail.com
          </a>
        </div>

        <!-- HIRE ME Button -->
        <button class="hire-me-footer-button" @click="openModal('contact')">
          <img src="/icons/icon_hireme.png" alt="Hire Me" class="hire-me-footer-img" />
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ============================================
     JUDICIAL FOOTER - SIMPLIFIED & COMPACT
     ============================================ */
  .judicial-footer {
    width: 100%;
    background: linear-gradient(180deg, #1d1007 0%, #150a04 100%);
    border-top: 3px solid #120803;
    box-shadow: inset 0 1.5px 0 #8e6527;
    padding: 32px 24px 24px;
    position: relative;
    transition: background 0.5s ease;
  }

  /* Dark mode */
  body.dark-mode .judicial-footer {
    background: linear-gradient(180deg, #0d0603 0%, #080402 100%);
  }

  .footer-container {
    width: 100%;
    padding: 0 40px;
  }

  /* ============================================
     GRID 2 KOLOM - SPREAD TO EDGES
     ============================================ */
  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }

  @media (max-width: 768px) {
    .footer-grid {
      flex-direction: column;
      gap: 32px;
    }
  }

  /* ============================================
     KOLOM KIRI - NAMA & MOTTO (LEFT ALIGNED)
     ============================================ */
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 0 auto;
    align-items: flex-start;
  }

  /* Nama Utama */
  .footer-name {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #f8f5eb;
    text-shadow: 2px 2px 0px #0c0502, 3px 3px 0px #000000;
    margin: 0;
    line-height: 1.2;
  }

  /* Kutipan Motto */
  .quality-motto {
    font-family: 'Special Elite', monospace;
    font-size: 13px;
    font-style: italic;
    line-height: 1.6;
    color: #a89984;
    margin: 0;
    padding-left: 0;
    border-left: none;
    max-width: 420px;
  }

  /* ============================================
     KOLOM KANAN - CONTACT LINKS & HIRE ME (RIGHT ALIGNED)
     ============================================ */
  .footer-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 0 auto;
    align-items: flex-end;
  }

  /* Contact Links - Simple Text Links (Right Aligned) */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
  }

  .contact-link {
    font-family: 'Special Elite', monospace;
    font-size: 13px;
    color: #d9b873;
    text-decoration: none;
    transition: color 0.2s ease;
    text-align: right;
  }

  .contact-link:hover {
    color: #f8f5eb;
    text-decoration: underline;
  }

  /* ============================================
     HIRE ME FOOTER BUTTON - COMPACT SIZE
     ============================================ */
  .hire-me-footer-button {
    width: fit-content;
    height: auto;
    background: #9c4c16;
    border: 3px solid #251205;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 0 #190c03;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
    margin-top: 8px;
    padding: 6px 14px;
  }

  .hire-me-footer-img {
    width: 110px;
    height: auto;
    object-fit: contain;
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hire-me-footer-button:hover {
    background: #b2591b;
    transform: translateY(-2px);
    box-shadow: 0 4px 0 #190c03;
  }

  .hire-me-footer-button:hover .hire-me-footer-img {
    transform: scale(1.05);
  }

  .hire-me-footer-button:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 #190c03;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    .judicial-footer {
      padding: 28px 16px 20px;
    }

    .footer-container {
      padding: 0 20px;
    }

    .footer-grid {
      gap: 28px;
    }

    .footer-name {
      font-size: 24px;
    }

    .quality-motto {
      font-size: 12px;
    }

    .footer-right {
      align-items: flex-start;
    }

    .contact-links {
      align-items: flex-start;
    }

    .contact-link {
      font-size: 12px;
      text-align: left;
    }

    .hire-me-footer-img {
      width: 100px;
    }
  }

  @media (max-width: 480px) {
    .footer-container {
      padding: 0 12px;
    }

    .footer-name {
      font-size: 20px;
    }

    .quality-motto {
      font-size: 11px;
    }

    .contact-link {
      font-size: 11px;
    }

    .hire-me-footer-img {
      width: 90px;
    }
  }
</style>
