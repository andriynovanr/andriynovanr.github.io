---
// HeroCard - Central hero card with ornate border and confidential stamp
---

<section id="hero" class="hero-section">
  <div class="hero-card card-parchment">
    <!-- Corner ornaments -->
    <div class="corner-ornament top-left">✦</div>
    <div class="corner-ornament top-right">✦</div>
    <div class="corner-ornament bottom-left">✦</div>
    <div class="corner-ornament bottom-right">✦</div>

    <!-- Confidential stamp -->
    <div class="confidential-stamp">
      <div class="stamp-inner">
        <div class="monogram">ANR</div>
        <div class="stamp-text">CONFIDENTIAL</div>
      </div>
    </div>

    <!-- Main content -->
    <div class="hero-content">
      <h1 class="hero-name">ANDRIY NOVAN RAHMAN</h1>
      <p class="hero-title">Presiding Officer of Code Integrity & Vulnerability Assessment</p>
      
      <div class="hero-divider"></div>
      
      <p class="hero-bio">
        Software QA Engineer | Full-Stack Developer | Penetration Testing Specialist
      </p>
      
      <p class="hero-subtitle">
        Telkom University Surabaya • Software Engineering Graduate
      </p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    margin-bottom: 32px;
  }

  .hero-card {
    position: relative;
    text-align: center;
  }

  /* Double border decoration */
  .hero-card::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    bottom: 12px;
    border: 1px solid var(--color-gold);
    border-radius: 4px;
    pointer-events: none;
  }

  /* Corner ornaments */
  .corner-ornament {
    position: absolute;
    font-size: 24px;
    color: var(--color-gold);
    z-index: 1;
  }

  .corner-ornament.top-left {
    top: 8px;
    left: 8px;
  }

  .corner-ornament.top-right {
    top: 8px;
    right: 8px;
  }

  .corner-ornament.bottom-left {
    bottom: 8px;
    left: 8px;
  }

  .corner-ornament.bottom-right {
    bottom: 8px;
    right: 8px;
  }

  /* Confidential stamp */
  .confidential-stamp {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 100px;
    height: 100px;
    transform: rotate(-15deg);
    z-index: 2;
  }

  .stamp-inner {
    width: 100%;
    height: 100%;
    border: 3px solid var(--color-burgundy);
    border-radius: 50%;
    background: rgba(128, 0, 32, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .monogram {
    font-size: 24px;
    font-weight: bold;
    color: var(--color-burgundy);
    font-family: 'Georgia', serif;
    line-height: 1;
  }

  .stamp-text {
    font-size: 10px;
    font-weight: bold;
    color: var(--color-burgundy);
    letter-spacing: 0.05em;
    margin-top: 4px;
  }

  /* Hero content */
  .hero-content {
    position: relative;
    z-index: 1;
    padding: 32px 20px;
  }

  .hero-name {
    font-size: 32px;
    font-weight: bold;
    color: var(--color-ink);
    letter-spacing: 0.08em;
    margin: 0 0 16px 0;
    font-family: 'Georgia', serif;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: 16px;
    font-style: italic;
    color: var(--color-ink-light);
    margin: 0 0 24px 0;
    line-height: 1.5;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-divider {
    width: 120px;
    height: 2px;
    background: var(--color-gold);
    margin: 24px auto;
  }

  .hero-bio {
    font-size: 14px;
    color: var(--color-ink);
    margin: 16px 0;
    font-weight: 600;
  }

  .hero-subtitle {
    font-size: 13px;
    color: var(--color-ink-light);
    margin: 8px 0 0 0;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .hero-card {
      padding: 20px;
    }

    .hero-content {
      padding: 24px 16px;
    }

    .hero-name {
      font-size: 24px;
    }

    .hero-title {
      font-size: 14px;
    }

    .confidential-stamp {
      width: 80px;
      height: 80px;
      top: 16px;
      right: 16px;
    }

    .monogram {
      font-size: 20px;
    }

    .stamp-text {
      font-size: 8px;
    }

    .corner-ornament {
      font-size: 18px;
    }
  }

  @media (min-width: 768px) {
    .hero-name {
      font-size: 36px;
    }

    .hero-title {
      font-size: 18px;
    }
  }
</style>
