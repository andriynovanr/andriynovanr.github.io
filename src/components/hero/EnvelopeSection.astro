---
// EnvelopeSection - Photo ID Card with hover effects
---

<section id="envelope" class="envelope-section">
  <div class="photo-card-container">
    <!-- Base Card Manila -->
    <div class="witness-card">
      <!-- Photo Frame dengan foto di dalamnya -->
      <div class="photo-frame-wrapper">
        <img src="/icons/icon_photo.png" alt="Photo Frame" class="photo-frame-border" />
        <div class="photo-inner"></div>
      </div>
      
      <!-- Text Content di bawah foto -->
      <div class="witness-info">
        <!-- Baris 1: Role -->
        <div class="witness-role">WITNESS · QA ENGINEER</div>
        
        <!-- Baris 2: Nama (Highlight utama) -->
        <div class="witness-name">ANDRIY NOVAN RAHMAN</div>
        
        <!-- Baris 3: Case Number Pill -->
        <div class="case-number-pill">CASE NO. ANR-2026</div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .envelope-section {
    margin-top: 20px;
    margin-bottom: 50px;
    display: flex;
    justify-content: flex-start;
    padding-left: 0px;
    position: relative;
    z-index: 10;
  }

  .photo-card-container {
    margin-left: -180px;
    perspective: 1000px;
  }

  /* ===== BASE CARD MANILA ===== */
  .witness-card {
    position: relative;
    width: 420px;
    background: #B69F68;
    border: 4px solid #1E140A;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 6px 8px 0px #140B05;
    cursor: pointer;
    
    /* Default State: Sedikit miring */
    transform: translateY(0px) rotate(-1.5deg) scale(1);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* ===== HOVER STATE: Kartu Terangkat ===== */
  .witness-card:hover {
    transform: translateY(-8px) rotate(0deg) scale(1.025);
    box-shadow: 8px 16px 0px #140B05, 0px 20px 40px rgba(20, 11, 5, 0.45);
  }

  /* ===== PHOTO FRAME WRAPPER ===== */
  .photo-frame-wrapper {
    position: relative;
    width: 100%;
    height: 420px;
    margin-bottom: 14px;
  }

  /* Border bingkai di bawah sebagai base layer */
  .photo-frame-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
    border-radius: 12px;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Pendaran kuning pada bingkai */
  .witness-card:hover .photo-frame-border {
    box-shadow: 0 0 10px rgba(255, 230, 59, 0.35);
  }

  /* Foto di atas bingkai */
  .photo-inner {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 214px;
    height: 269px;
    background-image: url('/icons/my_photo.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 2;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Zoom foto perlahan */
  .witness-card:hover .photo-inner {
    transform: translate(-50%, -50%) scale(1.04);
  }

  /* ===== WITNESS INFO TEXT ===== */
  .witness-info {
    text-align: center;
    padding: 0 16px;
  }

  /* Baris 1: Role */
  .witness-role {
    font-family: 'Special Elite', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #1E140A;
    opacity: 0.75;
    margin-bottom: 6px;
    transition: opacity 0.25s ease;
  }

  .witness-card:hover .witness-role {
    opacity: 1;
  }

  /* Baris 2: Nama (HIGHLIGHT UTAMA) */
  .witness-name {
    font-family: 'Special Elite', monospace;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1E140A;
    margin-bottom: 9px;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Nama menyala kuning emas dengan outline hitam */
  .witness-card:hover .witness-name {
    color: #FFE63B;
    transform: translateY(-1px);
    text-shadow: 
      -1.5px -1.5px 0px #1E140A,
       1.5px -1.5px 0px #1E140A,
      -1.5px  1.5px 0px #1E140A,
       1.5px  1.5px 0px #1E140A,
       0px    2px   0px #140B05;
  }

  /* Baris 3: Case Number Pill */
  .case-number-pill {
    display: inline-block;
    width: 135px;
    height: 21px;
    background: #CEB98A;
    border: 1.5px solid #1E140A;
    border-radius: 10.5px;
    font-family: 'Special Elite', monospace;
    font-size: 9px;
    font-weight: 700;
    color: #1E140A;
    line-height: 21px;
    text-align: center;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Pill berubah merah dengan teks kuning */
  .witness-card:hover .case-number-pill {
    background: #A42422;
    color: #FFE63B;
    box-shadow: 0px 2px 0px #1E140A;
  }

  /* ===== RESPONSIVE ADJUSTMENTS ===== */
  @media (max-width: 640px) {
    .photo-card-container {
      margin-left: -120px;
    }

    .witness-card {
      width: 430px;
    }

    .photo-frame-wrapper {
      height: 430px;
    }
    
    .photo-inner {
      width: 219px;
      height: 275px;
    }

    .witness-name {
      font-size: 13px;
    }
  }

  @media (max-width: 480px) {
    .photo-card-container {
      margin-left: -90px;
    }

    .witness-card {
      width: 360px;
      padding: 16px;
    }

    .photo-frame-wrapper {
      height: 360px;
    }
    
    .photo-inner {
      width: 183px;
      height: 230px;
    }

    .witness-role {
      font-size: 9px;
    }

    .witness-name {
      font-size: 12px;
    }

    .case-number-pill {
      font-size: 8px;
      width: 120px;
      height: 19px;
      line-height: 19px;
    }
  }
</style>
