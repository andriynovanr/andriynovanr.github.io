---
// EnvelopeSection - Photo ID Card with hover effects
---

<section id="envelope" class="envelope-section">
  <div class="photo-card-container">
    <!-- Base Card Manila -->
    <div class="witness-card">
      <!-- Photo Frame dengan foto di dalamnya -->
      <div class="photo-frame-wrapper">
        <!-- Icon paperclip di kiri atas -->
        <img src="/icons/icon_paperclip.png" alt="Paperclip" class="icon-paperclip" />
        
        <!-- Icon on stand di kanan atas -->
        <img src="/icons/icon_onstand.png" alt="On Stand" class="icon-onstand" />
        
        <!-- Garis pembatas atas -->
        <div class="frame-border-top"></div>
        
        <div class="photo-inner"></div>
        
        <!-- Garis pembatas bawah -->
        <div class="frame-border-bottom"></div>
        
        <!-- Text overlay di dalam bingkai, di atas frame tapi di bawah foto -->
        <div class="text-overlay-wrapper">
          <!-- Baris 1: Nama -->
          <div class="witness-name-overlay">ANDRIY NOVAN RAHMAN</div>
          
          <!-- Baris 2: Tanggal Lahir Pill -->
          <div class="case-number-pill-overlay">28 MAY 2005</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .envelope-section {
    margin-top: 0;
    margin-bottom: 0;
    position: relative;
    z-index: 10;
  }

  .photo-card-container {
    margin-left: 0;
    perspective: 1000px;
  }

  /* ===== BASE CARD MANILA ===== */
  .witness-card {
    position: relative;
    width: 360px;
    background: #B69F68;
    border: 2px solid #1E140A;
    border-radius: 16px;
    padding: 12px;
    box-shadow: 6px 8px 0px #140B05;
    cursor: pointer;
    
    /* Default State: Sedikit miring */
    transform: translateY(0px) rotate(-1.5deg) scale(1);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* ===== HOVER STATE: Kartu Terangkat ===== */
  .witness-card:hover {
    transform: translateY(-8px) rotate(0deg) scale(1.025);
    box-shadow: 8px 16px 0px #140B05, 0px 20px 40px rgba(20, 11, 5, 0.45);
  }

  /* ===== PHOTO FRAME WRAPPER ===== */
  .photo-frame-wrapper {
    position: relative;
    width: 100%;
    height: 460px;
    margin-bottom: 12px;
    background: #B69F68;
    border-radius: 12px;
  }

  /* Icon paperclip di kiri atas */
  .icon-paperclip {
    position: absolute;
    top: -42px;
    left: 6px;
    width: 65px;
    height: auto;
    z-index: 10;
    transform: rotate(-12deg);
  }

  /* Icon on stand di kanan atas */
  .icon-onstand {
    position: absolute;
    top: -10px;
    right: 12px;
    width: 70px;
    height: auto;
    z-index: 10;
  }

  /* Garis pembatas atas */
  .frame-border-top {
    position: absolute;
    top: 25px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 3px;
    background: #1E140A;
    border-radius: 2px;
    z-index: 1;
  }

  /* Garis pembatas bawah */
  .frame-border-bottom {
    position: absolute;
    bottom: 78px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 3px;
    background: #1E140A;
    border-radius: 2px;
    z-index: 1;
  }

  /* Foto di dalam wrapper */
  .photo-inner {
    position: absolute;
    top: 44%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 260px;
    height: 327px;
    background-image: url('/icons/my_photo.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 3;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Zoom foto perlahan + pendaran kuning pada foto */
  .witness-card:hover .photo-inner {
    transform: translate(-50%, -50%) scale(1.04);
    box-shadow: 0 0 15px rgba(255, 230, 59, 0.6);
  }

  /* ===== TEXT OVERLAY WRAPPER DI DALAM BINGKAI ===== */
  .text-overlay-wrapper {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  /* Baris 1: Nama (HIGHLIGHT UTAMA) */
  .witness-name-overlay {
    font-family: 'Special Elite', monospace;
    font-size: 15px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1E140A;
    text-align: center;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Nama menyala kuning emas dengan outline hitam */
  .witness-card:hover .witness-name-overlay {
    color: #FFE63B;
    transform: translateY(-1px);
    text-shadow: 
      -1.5px -1.5px 0px #1E140A,
       1.5px -1.5px 0px #1E140A,
      -1.5px  1.5px 0px #1E140A,
       1.5px  1.5px 0px #1E140A,
       0px    2px   0px #140B05;
  }

  /* Baris 2: Tanggal Lahir Pill */
  .case-number-pill-overlay {
    display: inline-block;
    width: 145px;
    height: 24px;
    background: #CEB98A;
    border: 1px solid #1E140A;
    border-radius: 12px;
    font-family: 'Special Elite', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #1E140A;
    line-height: 24px;
    text-align: center;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover: Pill berubah merah dengan teks kuning */
  .witness-card:hover .case-number-pill-overlay {
    background: #A42422;
    color: #FFE63B;
    box-shadow: 0px 2px 0px #1E140A;
  }

  /* ===== RESPONSIVE ADJUSTMENTS ===== */
  @media (max-width: 640px) {
    .photo-card-container {
      margin-left: -120px;
    }

    .witness-card {
      width: 430px;
    }

    .photo-frame-wrapper {
      height: 430px;
    }
    
    .photo-inner {
      width: 219px;
      height: 275px;
    }

    .witness-name {
      font-size: 13px;
    }
  }

  @media (max-width: 480px) {
    .photo-card-container {
      margin-left: -90px;
    }

    .witness-card {
      width: 360px;
      padding: 16px;
    }

    .photo-frame-wrapper {
      height: 360px;
    }
    
    .photo-inner {
      width: 183px;
      height: 230px;
    }

    .witness-role {
      font-size: 9px;
    }

    .witness-name {
      font-size: 12px;
    }

    .case-number-pill {
      font-size: 8px;
      width: 120px;
      height: 19px;
      line-height: 19px;
    }
  }
</style>
