---
// Hero Plaque - Judge's Desk Brass & Wood Nameplate
---

<div class="hero-plaque-container">
  <div class="judge-nameplate">
    <!-- Lapisan Luar: Tatakan Kayu Mahoni -->
    <div class="wooden-backing-plinth">
      <!-- Lapisan Dalam: Pelat Kuningan Logam -->
      <div class="brass-plate-inner">
        <!-- Sekrup Kuningan Kiri Atas -->
        <div class="brass-screw brass-screw-left">
          <div class="screw-hole"></div>
        </div>
        <!-- Sekrup Kuningan Kanan Atas -->
        <div class="brass-screw brass-screw-right">
          <div class="screw-hole"></div>
        </div>
        
        <!-- Konten Teks -->
        <div class="nameplate-text-content">
          <h1 class="primary-name">ANDRIY NOVAN RAHMAN</h1>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-plaque-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0px 20px 20px;
    margin-top: -35px;
    position: relative;
    z-index: 10;
  }

  .judge-nameplate {
    width: 100%;
    max-width: 480px;
    position: relative;
  }

  /* Lapisan Luar: Tatakan Kayu Mahoni */
  .wooden-backing-plinth {
    width: 100%;
    aspect-ratio: 4 / 1;
    background: linear-gradient(
      180deg,
      #3A1C0A 0%,
      #3E1E0B 20%,
      #44220D 50%,
      #3E1E0B 80%,
      #3A1C0A 100%
    );
    border: 4.5px solid #180A03;
    border-radius: 18px;
    padding: 12px;
    position: relative;
    box-shadow: 
      0 8px 16px rgba(0, 0, 0, 0.6),
      0 12px 28px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(120, 60, 20, 0.15);
  }

  /* Lapisan Dalam: Pelat Kuningan Logam */
  .brass-plate-inner {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to right,
      #A26F2E 0%,
      #B57F38 12%,
      #C89346 24%,
      #D4A759 40%,
      #DCB365 48%,
      #E0B86B 50%,
      #DCB365 52%,
      #D4A759 60%,
      #B98842 76%,
      #A3722F 88%,
      #956226 100%
    );
    border: 2.5px solid #2A1406;
    border-radius: 11px;
    position: relative;
    box-shadow: 
      inset 0 1px 1px rgba(243, 216, 150, 0.7),
      inset 0 -2px 3px rgba(60, 30, 10, 0.4),
      0 3px 8px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 14px 20px;
  }

  /* Garis Kilau Tepi Atas (Inner Highlight Edge) */
  .brass-plate-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 11px;
    right: 11px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      #F3D896 15%,
      #F3D896 85%,
      transparent 100%
    );
    border-radius: 11px 11px 0 0;
  }

  /* Sekrup Kuningan (Brass Mounting Screws) */
  .brass-screw {
    position: absolute;
    top: 16%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 35%,
      #F5DF92 0%,
      #E5C96A 30%,
      #C9A747 70%,
      #A68630 100%
    );
    border: 1.5px solid #1A0C04;
    box-shadow: 
      inset 0 1px 1px rgba(255, 255, 255, 0.4),
      inset 0 -1px 2px rgba(0, 0, 0, 0.3),
      0 2px 4px rgba(0, 0, 0, 0.3);
    z-index: 5;
  }

  .brass-screw-left {
    left: 12%;
  }

  .brass-screw-right {
    right: 12%;
  }

  /* Lubang Tengah Sekrup */
  .screw-hole {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #1A0C04;
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.8);
  }

  /* Konten Teks */
  .nameplate-text-content {
    text-align: center;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  /* Teks Nama Utama - ANDRIY NOVAN RAHMAN */
  .primary-name {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: clamp(18px, 3.8vw, 26px);
    font-weight: 900;
    letter-spacing: 1.5px;
    color: #1B0E05;
    text-transform: uppercase;
    margin: 0;
    padding: 0;
    line-height: 1;
    text-shadow: 
      1px 1px 0 rgba(255, 255, 255, 0.15),
      -0.5px -0.5px 0 rgba(0, 0, 0, 0.4),
      2px 2px 3px rgba(0, 0, 0, 0.2);
    -webkit-text-stroke: 0.5px #0D0602;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .hero-plaque-container {
      padding: 0px 16px 18px;
      margin-top: -25px;
    }

    .judge-nameplate {
      max-width: 100%;
    }

    .brass-plate-inner {
      padding: 10px 16px;
    }

    .primary-name {
      letter-spacing: 1px;
      -webkit-text-stroke: 0.4px #0D0602;
    }

    .brass-screw {
      width: 9px;
      height: 9px;
    }

    .screw-hole {
      width: 2.5px;
      height: 2.5px;
    }
  }

  @media (max-width: 480px) {
    .wooden-backing-plinth {
      padding: 10px;
      border-width: 3.5px;
      border-radius: 14px;
    }

    .brass-plate-inner {
      border-width: 2px;
      border-radius: 9px;
      padding: 8px 12px;
    }

    .primary-name {
      letter-spacing: 0.8px;
      -webkit-text-stroke: 0.3px #0D0602;
    }

    .brass-screw {
      width: 8px;
      height: 8px;
      top: 18%;
    }

    .brass-screw-left {
      left: 10%;
    }

    .brass-screw-right {
      right: 10%;
    }
  }
</style>
