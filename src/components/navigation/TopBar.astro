---
// TopBar - Supreme Bench Record Top Navbar dengan Nama
---

<header class="supreme-navbar">
  <div class="navbar-container">
    <!-- Nama Utama Saja -->
    <h1 class="main-name">ANDRIY NOVAN RAHMAN</h1>
  </div>
</header>

<style>
  /* ============================================
     SUPREME BENCH RECORD TOP NAVBAR
     ============================================ */
  .supreme-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 68px;
    background: linear-gradient(180deg, #26160a 0%, #1c0e05 100%);
    border-bottom: 3px solid #120803;
    border-top: 1px solid #3d2413;
    box-shadow: 
      0 4px 0px 0px #0c0502,
      0 8px 16px rgba(0, 0, 0, 0.45);
    z-index: 50;
    padding: 0 24px;
  }

  .navbar-container {
    max-width: 1400px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* ============================================
     NAMA UTAMA (Center Aligned)
     ============================================ */
  .main-name {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #f8f5eb;
    text-shadow: 1.5px 1.5px 0px #0f0703;
    margin: 0;
    line-height: 1;
  }

  /* ============================================
     RESPONSIVE ADJUSTMENTS
     ============================================ */
  @media (max-width: 768px) {
    .supreme-navbar {
      height: 60px;
      padding: 0 16px;
    }

    .main-name {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .supreme-navbar {
      height: 56px;
      padding: 0 12px;
    }

    .main-name {
      font-size: 13px;
    }
  }
</style>
