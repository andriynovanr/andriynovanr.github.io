---
// TopBar - Supreme Bench Record Top Navbar dengan Nama
---

<header class="supreme-navbar">
  <div class="navbar-container">
    <!-- Nama Utama di Kiri -->
    <h1 class="main-name">ANDRIY NOVAN RAHMAN</h1>
    
    <!-- Menu Navigation di Kanan -->
    <nav class="top-nav-menu">
      <a href="#hero" class="top-nav-item">
        <div class="top-nav-icon home-icon">
          <img src="/icons/icon_home.png" alt="Home" class="top-nav-img" />
        </div>
        <span class="top-nav-label">HOME</span>
      </a>

      <a href="/documents/Andriy Novan Rahman_CV.pdf" target="_blank" rel="noopener noreferrer" class="top-nav-item">
        <div class="top-nav-icon resume-icon">
          <img src="/icons/icon_resume.png" alt="Resume" class="top-nav-img" />
        </div>
        <span class="top-nav-label">RESUME</span>
      </a>

      <a href="https://github.com/andriynovanr" target="_blank" rel="noopener noreferrer" class="top-nav-item">
        <div class="top-nav-icon github-icon">
          <img src="/icons/icon_github.png" alt="GitHub" class="top-nav-img" />
        </div>
        <span class="top-nav-label">GITHUB</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* ============================================
     SUPREME BENCH RECORD TOP NAVBAR
     ============================================ */
  .supreme-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 68px;
    background: linear-gradient(180deg, #26160a 0%, #1c0e05 100%);
    border-bottom: 3px solid #120803;
    border-top: 1px solid #3d2413;
    box-shadow: 
      0 4px 0px 0px #0c0502,
      0 8px 16px rgba(0, 0, 0, 0.45);
    z-index: 50;
    padding: 0 24px;
  }

  .navbar-container {
    max-width: 1400px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ============================================
     NAMA UTAMA (Left Aligned)
     ============================================ */
  .main-name {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #f8f5eb;
    text-shadow: 1.5px 1.5px 0px #0f0703;
    margin: 0;
    line-height: 1;
  }

  /* ============================================
     TOP NAVIGATION MENU (Right Side)
     ============================================ */
  .top-nav-menu {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .top-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .top-nav-item:hover {
    transform: translateY(-2px);
  }

  .top-nav-icon {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .top-nav-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .home-icon {
    background: transparent;
    box-shadow: none;
  }

  .resume-icon {
    background: #bfa770;
    border: 3px solid #000000;
  }

  .github-icon {
    background: #2a2c2c;
    box-shadow: 0 3px 0 #1a1a1a;
    border: 3px solid #000000;
    border-radius: 8px;
  }

  .top-nav-item:hover .top-nav-img {
    transform: scale(1.08);
  }

  .top-nav-item:hover .resume-icon {
    background: #ccb682;
  }

  .top-nav-item:hover .github-icon {
    background: #393d3d;
    box-shadow: 0 5px 0 #1a1a1a;
  }

  .top-nav-label {
    font-size: 8px;
    font-weight: bold;
    font-family: 'VT323', monospace;
    color: #f4cd58;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  /* ============================================
     RESPONSIVE ADJUSTMENTS
     ============================================ */
  @media (max-width: 768px) {
    .supreme-navbar {
      height: 60px;
      padding: 0 16px;
    }

    .main-name {
      font-size: 16px;
    }

    .top-nav-menu {
      gap: 18px;
    }

    .top-nav-icon {
      width: 36px;
      height: 36px;
    }

    .top-nav-img {
      width: 56px;
      height: 56px;
    }

    .top-nav-label {
      font-size: 7px;
    }
  }

  @media (max-width: 480px) {
    .supreme-navbar {
      height: 56px;
      padding: 0 12px;
    }

    .main-name {
      font-size: 13px;
    }

    .top-nav-menu {
      gap: 12px;
    }

    .top-nav-icon {
      width: 32px;
      height: 32px;
    }

    .top-nav-img {
      width: 48px;
      height: 48px;
    }

    .top-nav-label {
      font-size: 6px;
    }
  }
</style>
