---
// SanityMeter - Retro RPG courtroom HUD status gauge (Compact inline version)
---

<div class="sanity-meter-inline" x-data="{ sanityValue: 85 }">
  <div class="sanity-card-container">
    <!-- Teks Label & Persentase -->
    <div class="sanity-header-row">
      <span class="sanity-label">SANITY / ENERGY</span>
      <span class="sanity-percentage" x-text="'%' + sanityValue"></span>
    </div>
    
    <!-- Progress Bar Meteran Energi -->
    <div class="energy-gauge-track">
      <div 
        class="energy-fill-bar" 
        :style="`width: ${sanityValue}%`"
      >
        <div class="energy-shine-highlight"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ============================================
     INLINE COMPACT VERSION
     ============================================ */
  .sanity-meter-inline {
    display: inline-flex;
    align-items: center;
    pointer-events: auto;
    margin-top: 7px;
  }

  /* ============================================
     WADAH / KOTAK KARTU LUAR - COMPACT SIZE
     ============================================ */
  .sanity-card-container {
    width: 160px;
    height: 52px;
    background: linear-gradient(
      180deg,
      #CBB584 0%,
      #C5AF7D 50%,
      #C2AC7A 100%
    );
    border: 3px solid #1A0F07;
    border-radius: 14px;
    padding: 8px 12px;
    box-shadow: 
      0 3px 10px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    position: relative;
  }

  /* ============================================
     HEADER ROW - Label & Persentase
     ============================================ */
  .sanity-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  /* A. Teks Label "SANITY / ENERGY" */
  .sanity-label {
    font-family: 'Patrick Hand', 'Gochi Hand', 'Comic Neue', cursive;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #1D1007;
    line-height: 1;
    white-space: nowrap;
  }

  /* B. Teks Persentase "%85" - Merah Marun */
  .sanity-percentage {
    font-family: 'Patrick Hand', 'Permanent Marker', 'Architects Daughter', cursive;
    font-size: 10px;
    font-weight: 800;
    color: #8B263E;
    line-height: 1;
    font-style: italic;
    transform: rotate(-2deg);
    text-shadow: 
      0.5px 0.5px 0 rgba(0, 0, 0, 0.2),
      1px 1px 2px rgba(0, 0, 0, 0.15);
  }

  /* ============================================
     PROGRESS BAR - COMPACT
     ============================================ */
  
  /* A. Wadah / Rel Latar Belakang Bar (Track) */
  .energy-gauge-track {
    width: 100%;
    height: 11px;
    background: linear-gradient(
      180deg,
      #521721 0%,
      #5C1926 50%,
      #4D1520 100%
    );
    border: 2px solid #160B04;
    border-radius: 999px;
    position: relative;
    overflow: visible;
    box-shadow: 
      inset 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  /* Border tebal di bawah progress bar */
  .energy-gauge-track::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 3px;
    background: #1A0F07;
    border-radius: 999px;
  }

  /* B. Isian Bar Aktif */
  .energy-fill-bar {
    height: 100%;
    background: linear-gradient(
      180deg,
      #FF5E97 0%,
      #F4528E 50%,
      #E83E7A 100%
    );
    border-radius: 999px 4px 4px 999px;
    position: relative;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 0 6px rgba(255, 94, 151, 0.4);
  }

  /* Garis Kilau Tipis Atas (Inner Highlight) */
  .energy-shine-highlight {
    position: absolute;
    top: 1px;
    left: 3px;
    right: 3px;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #FFA3C4 20%,
      #FFB8D5 50%,
      #FFA3C4 80%,
      transparent 100%
    );
    border-radius: 999px;
    opacity: 0.7;
  }

  /* ============================================
     RESPONSIVE ADJUSTMENTS
     ============================================ */
  @media (max-width: 768px) {
    .sanity-card-container {
      width: 140px;
      height: 48px;
      padding: 7px 10px;
      border-width: 2.5px;
      border-radius: 12px;
    }

    .sanity-label {
      font-size: 9px;
      letter-spacing: 0.6px;
    }

    .sanity-percentage {
      font-size: 13px;
    }

    .energy-gauge-track {
      height: 10px;
    }

    .sanity-header-row {
      margin-bottom: 5px;
    }
  }

  @media (max-width: 480px) {
    .sanity-card-container {
      width: 120px;
      height: 44px;
      padding: 6px 9px;
      border-width: 2px;
      border-radius: 11px;
    }

    .sanity-label {
      font-size: 8px;
      letter-spacing: 0.5px;
    }

    .sanity-percentage {
      font-size: 12px;
    }

    .energy-gauge-track {
      height: 9px;
    }

    .sanity-header-row {
      margin-bottom: 4px;
    }
  }
</style>
