---
// Career & Experience Tabbed Exhibit Board (IMAGE_60)
// Main testimony card with three career specialization tabs
---

<div class="career-exhibit-wrapper">
  <!-- Main mahogany board -->
  <div class="career-exhibit-board">
    <!-- Three tab buttons -->
    <div class="career-tabs">
      <!-- Tab 1: Fuomo QA (inactive) -->
      <button
        class="career-tab"
        :class="{ 'career-tab--active': activeCareerTab === 1 }"
        @click="setCareerTab(1)"
        aria-label="Fuomo QA Intern tab"
      >
        Fuomo QA
      </button>
      <!-- Tab 2: Minilemon QA (default active) -->
      <button
        class="career-tab"
        :class="{ 'career-tab--active': activeCareerTab === 2 }"
        @click="setCareerTab(2)"
        aria-label="Minilemon QA Intern tab"
      >
        Minilemon QA
      </button>
      <!-- Tab 3: Security Research (inactive) -->
      <button
        class="career-tab"
        :class="{ 'career-tab--active': activeCareerTab === 3 }"
        @click="setCareerTab(3)"
        aria-label="Security Research tab"
      >
        Security Research
      </button>
    </div>

    <!-- Testimony card container -->
    <div class="testimony-card">
      <!-- Tab 1 content: Software QA -->
      <div x-show="activeCareerTab === 1" x-transition.opacity class="testimony-card-content">
        <div class="testimony-card-header">
          <span class="witness-id">WITNESS: ANDRIY NOVAN RAHMAN | QA INTERN @ FUOMO</span>
          <span class="witness-year">JUL 2026 – OCT 2026</span>
        </div>
        <p class="testimony-body">
          Quality assurance for Fuomo creator platform. Designed 100+ test cases for platform revamp, developed automated tests using Playwright (TypeScript), tested OBS streaming widgets, and worked with AWS CI pipeline for weekly deployments.
        </p>
        <div class="skill-badges">
          <span class="skill-badge" style="background:#7B3F00;">Playwright / TypeScript</span>
          <span class="skill-badge" style="background:#2A5C8A;">AWS CodeBuild</span>
          <span class="skill-badge" style="background:#4A6741;">PostgreSQL / Docker</span>
          <span class="skill-badge" style="background:#6B3A6B;">Test Automation</span>
          <span class="skill-badge" style="background:#8B5A3C;">Manual Testing</span>
        </div>
      </div>

      <!-- Tab 2 content: Full-Stack & Mobile -->
      <div x-show="activeCareerTab === 2" x-transition.opacity class="testimony-card-content">
        <div class="testimony-card-header">
          <span class="witness-id">WITNESS: ANDRIY NOVAN RAHMAN | QA INTERN @ MINILEMON</span>
          <span class="witness-year">AUG 2025 – JAN 2026</span>
        </div>
        <p class="testimony-body">
          End-to-end testing for ML-Space educational mobile app (React Native). Executed 55+ functional test cases, implemented 42 automated unit tests using Jest with 100% pass rate, conducted API tests via Convex and Postman, performed JMeter load testing.
        </p>
        <div class="skill-badges">
          <span class="skill-badge" style="background:#A82424;">Jest / Unit Testing</span>
          <span class="skill-badge" style="background:#2A7685;">React Native / Expo</span>
          <span class="skill-badge" style="background:#764599;">Performance Test / JMeter</span>
          <span class="skill-badge" style="background:#9E5218;">API Testing / Postman</span>
          <span class="skill-badge" style="background:#6B5A3C;">Convex API</span>
        </div>
      </div>

      <!-- Tab 3 content: Pentesting & Bug Bounty -->
      <div x-show="activeCareerTab === 3" x-transition.opacity class="testimony-card-content">
        <div class="testimony-card-header">
          <span class="witness-id">WITNESS: ANDRIY NOVAN RAHMAN | SECURITY RESEARCHER</span>
          <span class="witness-year">2024 – PRESENT</span>
        </div>
        <p class="testimony-body">
          Active participant in bug bounty programs on Bugcrowd and HackerOne. Specializing in web application penetration testing, ethical hacking, and vulnerability assessments. Focused on responsible disclosure and enhancing software security through OWASP methodologies.
        </p>
        <div class="skill-badges">
          <span class="skill-badge" style="background:#8B2020;">OWASP / Burp Suite</span>
          <span class="skill-badge" style="background:#1E5C6B;">Bug Bounty</span>
          <span class="skill-badge" style="background:#5C3A8A;">Penetration Testing</span>
          <span class="skill-badge" style="background:#6B4A18;">Security Research</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Animation for testimony content */
@keyframes testimonySlide {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.career-exhibit-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 0;
}

.career-exhibit-board {
  width: 100%;
  max-width: 1300px;
  min-width: 0;
  background: #522D16;
  border: 4.5px solid #1C0F06;
  border-radius: 26px;
  box-shadow: 0px 8px 0px #120A04;
  padding: 16px 28px 18px 28px;
}

/* Tab row */
.career-tabs {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

/* Base tab (inactive state) */
.career-tab {
  font-family: 'Special Elite', 'Courier New', monospace;
  font-size: 15px;
  font-weight: bold;
  background: #A95C22;
  color: #FCE7A4;
  border: 2.5px solid #1C0F06;
  border-radius: 12px;
  padding: 8px 14px;
  box-shadow: 0px 3px 0px #1C0F06;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  white-space: nowrap;
}

.career-tab:hover {
  background: #BA6A2D;
  color: #FEDB72;
  transform: translateY(-2px);
  box-shadow: 0px 5px 0px #1C0F06;
}

.career-tab:active {
  transform: translateY(2px);
  box-shadow: 0px 1px 0px #1C0F06;
}

/* Active tab state */
.career-tab--active {
  background: #B7D938;
  color: #1C0F06;
  border: 3px solid #1C0F06;
  border-radius: 12px;
  padding: 8px 14px;
  box-shadow: 0px 4px 0px #1C0F06;
  font-size: 16px;
  font-weight: 900;
  transform: translateY(0);
}

.career-tab--active:hover {
  background: #C3E840;
  color: #1C0F06;
  transform: translateY(-1px);
  box-shadow: 0px 5px 0px #1C0F06;
}

/* Inner parchment testimony card */
.testimony-card {
  background: #ECE4CE;
  border: 3px solid #1C0F06;
  border-radius: 16px;
  padding: 20px 40px;
  box-shadow: inset 0 2px 4px rgba(28, 15, 6, 0.08);
  min-height: 160px;
}

.testimony-card-content {
  animation: testimonySlide 0.25s cubic-bezier(0.2, 0.8, 0.4, 1);
}

/* Card header row */
.testimony-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid #1C0F06;
  padding-bottom: 8px;
  margin-bottom: 14px;
  gap: 8px;
  flex-wrap: wrap;
}

.witness-id {
  font-family: 'Special Elite', 'Courier New', monospace;
  font-size: 10.5px;
  font-weight: bold;
  letter-spacing: 0.06em;
  color: #1C0F06;
  flex: 1;
  min-width: 0;
}

.witness-year {
  font-family: 'Special Elite', 'Courier New', monospace;
  font-size: 10.5px;
  font-weight: bold;
  letter-spacing: 0.08em;
  color: rgba(28, 15, 6, 0.85);
  white-space: nowrap;
}

/* Testimony body text */
.testimony-body {
  font-family: 'Special Elite', 'Courier New', monospace;
  font-size: 12px;
  line-height: 1.65;
  color: #1C0F06;
  margin: 0 0 14px 0;
}

/* Skill badge row */
.skill-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.skill-badge {
  font-family: 'Special Elite', 'Courier New', monospace;
  font-size: 10.5px;
  font-weight: bold;
  color: #FDF5E2;
  border: 2px solid #1C0F06;
  border-radius: 8px;
  padding: 5px 12px;
  box-shadow: 2px 2px 0px #1C0F06;
  cursor: default;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  display: inline-block;
}

.skill-badge:hover {
  transform: translateY(-1.5px) scale(1.02);
  box-shadow: 3px 3px 0px #1C0F06;
}

/* Mobile responsive */
@media (max-width: 760px) {
  .career-exhibit-board {
    border-radius: 20px;
  }
  
  .career-tabs {
    gap: 8px;
  }
  
  .career-tab {
    font-size: 13px;
    padding: 7px 11px;
  }
  
  .career-tab--active {
    font-size: 14px;
    padding: 7px 11px;
  }
}

@media (max-width: 480px) {
  .testimony-card-header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .skill-badges {
    flex-direction: column;
  }
  
  .skill-badge {
    text-align: center;
  }
}
</style>
